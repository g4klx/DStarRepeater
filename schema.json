{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "DStarRepeater MQTT JSON Schema",
	"description": "Defines all JSON messages published by DStarRepeater to the MQTT 'json' and 'status' topics. The 'json' messages are the ones MMDVM-Host publishes for D-Star, so MMDVM-Display and other MMDVM-Host consumers read them as they are.",

	"oneOf": [
		{ "$ref": "#/$defs/topic_json" },
		{ "$ref": "#/$defs/topic_status" }
	],

	"$defs": {
		"timestamp": {
			"type": "string",
			"description": "When the message was published, UTC to the millisecond, as MMDVM-Host writes it",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
		},
		"dstar_callsign": {
			"type": "string",
			"description": "D-Star callsign, up to 8 characters, trailing padding removed (leading spaces kept, e.g. \"       E\" for echo)",
			"minLength": 0,
			"maxLength": 8
		},
		"dstar_extension": {
			"type": "string",
			"description": "D-Star callsign extension (short suffix), up to 4 characters, trailing padding removed",
			"minLength": 0,
			"maxLength": 4
		},
		"source": {
			"type": "string",
			"description": "Origin of the transmission",
			"enum": ["rf", "network"]
		},
		"action": {
			"type": "string",
			"description": "D-Star event action type",
			"enum": ["start", "end", "lost"]
		},
		"rpt_state": {
			"type": "string",
			"description": "Repeater state machine state",
			"enum": ["shutdown", "listening", "valid", "valid_wait", "invalid", "invalid_wait", "timeout", "timeout_wait", "network", "unknown"]
		},
		"rx_state": {
			"type": "string",
			"description": "Receiver state machine state",
			"enum": ["listening", "process_data", "process_slow_data", "unknown"]
		},
		"ber": {
			"type": "number",
			"description": "Bit Error Rate as a percentage",
			"minimum": 0.0
		},
		"loss": {
			"type": "number",
			"description": "Network packets lost as a percentage",
			"minimum": 0.0
		},
		"duration": {
			"type": "number",
			"description": "Length of the transmission in seconds",
			"minimum": 0.0
		},
		"rssi": {
			"type": "integer",
			"description": "Received signal strength in dBm (DVAP modem only)",
			"minimum": -256,
			"maximum": -1
		},
		"mmdvm_mode": {
			"type": "string",
			"description": "MMDVM-Host mode identifier",
			"enum": ["idle", "D-Star"]
		},

		"topic_json": {
			"description": "Messages published to {name}/json: event-driven, as MMDVM-Host publishes them for D-Star",
			"oneOf": [
				{ "$ref": "#/$defs/msg_mmdvm_mode" },
				{ "$ref": "#/$defs/msg_dstar_start" },
				{ "$ref": "#/$defs/msg_dstar_end_rf" },
				{ "$ref": "#/$defs/msg_dstar_end_network" },
				{ "$ref": "#/$defs/msg_dstar_lost_rf" },
				{ "$ref": "#/$defs/msg_dstar_lost_network" },
				{ "$ref": "#/$defs/msg_ber" },
				{ "$ref": "#/$defs/msg_rssi" }
			]
		},

		"msg_mmdvm_mode": {
			"description": "Published on a mode change: \"D-Star\" before each transmission starts, \"idle\" after its end or lost event",
			"type": "object",
			"properties": {
				"MMDVM": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"mode":      { "$ref": "#/$defs/mmdvm_mode" }
					},
					"required": ["timestamp", "mode"]
				}
			},
			"required": ["MMDVM"],
			"examples": [
				{ "MMDVM": { "timestamp": "2026-11-24T15:34:41.085Z", "mode": "D-Star" } },
				{ "MMDVM": { "timestamp": "2026-11-24T15:34:52.410Z", "mode": "idle" } }
			]
		},

		"msg_dstar_start": {
			"description": "Published when a D-Star transmission begins (RF or network). The reflector is always empty: MMDVM-Host reports the reflector its gateway is linked to, which the repeater does not know.",
			"type": "object",
			"properties": {
				"D-Star": {
					"type": "object",
					"properties": {
						"timestamp":    { "$ref": "#/$defs/timestamp" },
						"src_callsign": { "$ref": "#/$defs/dstar_callsign" },
						"src_ext":      { "$ref": "#/$defs/dstar_extension" },
						"dst_callsign": { "$ref": "#/$defs/dstar_callsign" },
						"source":       { "$ref": "#/$defs/source" },
						"action":       { "const": "start" },
						"reflector":    { "const": "" }
					},
					"required": ["timestamp", "src_callsign", "src_ext", "dst_callsign", "source", "action", "reflector"]
				}
			},
			"required": ["D-Star"],
			"examples": [
				{
					"D-Star": {
						"timestamp": "2026-11-24T15:34:41.095Z",
						"src_callsign": "MW0MWZ",
						"src_ext": "",
						"dst_callsign": "CQCQCQ",
						"source": "rf",
						"action": "start",
						"reflector": ""
					}
				}
			]
		},

		"msg_dstar_end_rf": {
			"description": "Published when a D-Star transmission received over RF ends normally",
			"type": "object",
			"properties": {
				"D-Star": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"duration":  { "$ref": "#/$defs/duration" },
						"ber":       { "$ref": "#/$defs/ber" },
						"action":    { "const": "end" }
					},
					"required": ["timestamp", "duration", "ber", "action"]
				}
			},
			"required": ["D-Star"],
			"examples": [
				{ "D-Star": { "timestamp": "2026-11-24T15:34:52.400Z", "duration": 11.3, "ber": 0.4, "action": "end" } }
			]
		},

		"msg_dstar_end_network": {
			"description": "Published when a D-Star transmission from the network ends normally",
			"type": "object",
			"properties": {
				"D-Star": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"duration":  { "$ref": "#/$defs/duration" },
						"loss":      { "$ref": "#/$defs/loss" },
						"action":    { "const": "end" }
					},
					"required": ["timestamp", "duration", "loss", "action"]
				}
			},
			"required": ["D-Star"],
			"examples": [
				{ "D-Star": { "timestamp": "2026-11-24T15:34:52.400Z", "duration": 11.3, "loss": 0.0, "action": "end" } }
			]
		},

		"msg_dstar_lost_rf": {
			"description": "Published when a D-Star transmission received over RF is lost (the modem lost the signal), or is open when the repeater is shut down or disabled",
			"type": "object",
			"properties": {
				"D-Star": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"duration":  { "$ref": "#/$defs/duration" },
						"ber":       { "$ref": "#/$defs/ber" },
						"action":    { "const": "lost" }
					},
					"required": ["timestamp", "duration", "ber", "action"]
				}
			},
			"required": ["D-Star"],
			"examples": [
				{ "D-Star": { "timestamp": "2026-11-24T15:34:52.400Z", "duration": 4.2, "ber": 3.1, "action": "lost" } }
			]
		},

		"msg_dstar_lost_network": {
			"description": "Published when a D-Star transmission from the network is lost (watchdog timeout), or is open when the repeater is shut down or disabled",
			"type": "object",
			"properties": {
				"D-Star": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"duration":  { "$ref": "#/$defs/duration" },
						"loss":      { "$ref": "#/$defs/loss" },
						"action":    { "const": "lost" }
					},
					"required": ["timestamp", "duration", "loss", "action"]
				}
			},
			"required": ["D-Star"],
			"examples": [
				{ "D-Star": { "timestamp": "2026-11-24T15:15:31.486Z", "duration": 3.0, "loss": 66.4, "action": "lost" } }
			]
		},

		"msg_ber": {
			"description": "Published once per second during an active RF transmission with the BER over the last second",
			"type": "object",
			"properties": {
				"BER": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"mode":      { "const": "D-Star" },
						"value":     { "$ref": "#/$defs/ber" }
					},
					"required": ["timestamp", "mode", "value"]
				}
			},
			"required": ["BER"],
			"examples": [
				{ "BER": { "timestamp": "2026-11-24T15:34:44.000Z", "mode": "D-Star", "value": 1.3 } }
			]
		},

		"msg_rssi": {
			"description": "Published once per second during an active RF transmission with the DVAP signal strength",
			"type": "object",
			"properties": {
				"RSSI": {
					"type": "object",
					"properties": {
						"timestamp": { "$ref": "#/$defs/timestamp" },
						"mode":      { "const": "D-Star" },
						"value":     { "$ref": "#/$defs/rssi" }
					},
					"required": ["timestamp", "mode", "value"]
				}
			},
			"required": ["RSSI"],
			"examples": [
				{ "RSSI": { "timestamp": "2026-11-24T15:34:44.000Z", "mode": "D-Star", "value": -85 } }
			]
		},

		"topic_status": {
			"description": "Published to {name}/status — polled once per second with full repeater state",
			"type": "object",
			"properties": {
				"myCall1":  { "$ref": "#/$defs/dstar_callsign" },
				"myCall2":  { "$ref": "#/$defs/dstar_extension" },
				"yourCall": { "$ref": "#/$defs/dstar_callsign" },
				"rptCall1": { "$ref": "#/$defs/dstar_callsign" },
				"rptCall2": { "$ref": "#/$defs/dstar_callsign" },
				"tx":       { "type": "boolean", "description": "True when the repeater is transmitting" },
				"rxState":  { "$ref": "#/$defs/rx_state" },
				"rptState": { "$ref": "#/$defs/rpt_state" },
				"ber":      { "$ref": "#/$defs/ber" },
				"text":     { "type": "string", "description": "Current slow-data text (empty when idle)" },
				"status1":  { "type": "string", "description": "User-configured status message 1" },
				"status2":  { "type": "string", "description": "User-configured status message 2" },
				"status3":  { "type": "string", "description": "User-configured status message 3" },
				"status4":  { "type": "string", "description": "User-configured status message 4" },
				"status5":  { "type": "string", "description": "User-configured status message 5" }
			},
			"required": ["myCall1", "myCall2", "yourCall", "rptCall1", "rptCall2", "tx", "rxState", "rptState", "ber", "text", "status1", "status2", "status3", "status4", "status5"],
			"examples": [
				{
					"myCall1": "",
					"myCall2": "",
					"yourCall": "",
					"rptCall1": "",
					"rptCall2": "",
					"tx": false,
					"rxState": "listening",
					"rptState": "listening",
					"ber": 0.0,
					"text": "",
					"status1": "",
					"status2": "",
					"status3": "",
					"status4": "",
					"status5": ""
				}
			]
		}
	}
}
